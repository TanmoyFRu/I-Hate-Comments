{
  "name": "i-hate-comments",
  "displayName": "I-Hate-Comments - Smart Comment Remover",
  "description": "Fast, deterministic comment remover to strip and remove comments, clean code, and delete inline or block comments across JavaScript, Python, HTML, C++, and 30+ languages.",
  "version": "1.0.3",
  "publisher": "TanmoyDebnath",
  "keywords": [
    "comment remover",
    "remove comments",
    "no comment",
    "strip comments",
    "delete comments",
    "comment cleaner",
    "clean code",
    "uncomment",
    "remove-comments",
    "code cleanup",
    "formatter",
    "minify"
  ],
  "icon": "asset/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/TanmoyFRu/I-Hate-Comments.git"
  },
  "bugs": {
    "url": "https://github.com/TanmoyFRu/I-Hate-Comments/issues"
  },
  "homepage": "https://github.com/TanmoyFRu/I-Hate-Comments#readme",
  "engines": {
    "vscode": ">=1.75.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "smartCommentRemover.removeComments",
        "title": "Remove Comments",
        "category": "Smart Comment Remover"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "smartCommentRemover.removeComments",
          "group": "1_modification",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "Smart Comment Remover",
      "properties": {
        "smartCommentRemover.preserveShebang": {
          "type": "boolean",
          "default": true,
          "description": "Preserve shebang lines (e.g., #!/usr/bin/env node) at the top of files."
        },
        "smartCommentRemover.preserveDirectives": {
          "type": "boolean",
          "default": false,
          "description": "Preserve linter/compiler directive comments (e.g. eslint-disable, @ts-ignore)."
        },
        "smartCommentRemover.collapseEmptyLines": {
          "type": "boolean",
          "default": true,
          "description": "Remove leftover blank lines created when removing full-line comments."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npx ts-node src/test/parser.test.ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "undici": "6.21.1"
  }
}